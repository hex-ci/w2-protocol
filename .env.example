# 复制为 .env 后填入真实值（.env 已被 gitignore）
# 目标服务（业务主通道）
W2_HOST=
W2_PORT=8083

# 抓包侧
W2_PHONE_IP=
W2_IFACE=

# 每日领取的任务 ID 清单（逗号分隔，不同账号/服可能不同）
W2_TASK_IDS=290,307,5042

# W2_CLIENT_TYPE 模拟的客户端类型：
W2_CLIENT_TYPE=ios

# 登录凭据（从抓包登录帧解密提取一次，长期有效；提取方法见 protocol/API.md）
# 只有 W2_LOGIN_WST 是服务端硬性校验的 SSO token，其余字段服务端宽容
# platform/channel/language/clientVer 不填时用 SDK 内置的 iOS 真机兜底值；
# Android 区账号必须显式配置为对应渠道值
W2_LOGIN_USERID=
W2_LOGIN_USERNAME=
W2_LOGIN_WST=
W2_LOGIN_INSTALLID=
W2_LOGIN_APPKEY=
W2_LOGIN_PLATFORM=
W2_LOGIN_CHANNEL=
W2_LOGIN_LANGUAGE=
W2_LOGIN_CLIENT_VER=
