# 模拟哪个客户端平台（ios|android）
# 缺省 ios；当前登录工具仅支持 iOS 选服，Android 选服 WebSocket 尚未实现
W2_PLATFORM=

# 渠道与版本（**必填**——无代码内置缺省，随渠道分发而变）
W2_LOGIN_CHANNEL=
W2_LOGIN_LANGUAGE=
W2_LOGIN_CLIENT_VER=
# SSO 请求 User-Agent 模板（不填 = 通用移动端 UA；{clientVer} 自动替换为版本号）
W2_LOGIN_UA=

# 抓包参数（w2watch 实时嗅探用）
W2_PHONE_IP=
W2_IFACE=

# 每日任务 ID 清单
W2_TASK_IDS=

# 活动定位（**必填** for npm run activity——活动名会随版本变，故按协议字段筛选）
# 22001 活动列表里的 activityType / activitySubType / activityGroupId 三个字段，
# 取自目标活动条目（可用 npm run activity -- --dry 配合抓包/客户端核对）
W2_ACTIVITY_TYPE=
W2_ACTIVITY_SUBTYPE=
W2_ACTIVITY_GROUP=

# ---- SSO 端点与客户端常量（**必填**——无代码内置缺省，端点/密钥随发布方而变） ----
# 缺任一项时 w2login 会明确报错缺失键；取值见 protocol/API.md 与本机渠道配置
W2_SSO_URL=
W2_SSO_APP_ID=
W2_SSO_APP_SECRET=
W2_SSO_SECURITY_KEY=
W2_SSO_LANG=
W2_SSO_SOURCE_AREA=
W2_SSO_VERSION=
# 选服服务器与选服请求参数
W2_SSO_CHOICE_HOST=
W2_SSO_CHOICE_PORT=
W2_SSO_CHOICE_LANG=
W2_SSO_DEVICE_INFO=
W2_SSO_GAME_VERSION=
# SSO 响应里承载账号标识的字段名（服务端下发；留空则 w2login 报缺失）
W2_SSO_USERID_FIELD=

# ---- 首次使用 ----
# 1. npm install
# 2. node scripts/w2login.js [邮箱或账号]   （终端内安全输入密码，完整登录 + 选服 + 凭据落盘）
# 3. 之后直接跑 npm run signin / npm run reward / npm run train
#    wst 失效时重跑 node scripts/w2login.js（静默续登，免密码）
